# mia/.htaccess — Route all requests through front controller
# Apache mod_rewrite required

RewriteEngine On

# Subdomain root (mia.ainitravel.com) uses RewriteBase /
# Local /mia/ dev: change to RewriteBase /mia/
RewriteBase /

# If file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
